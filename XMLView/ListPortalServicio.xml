<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : ListPortalServicio.xml
    Description:
        Columnas del listado de servicios en la pestaña "services" del portal cliente.
-->
<view>
    <columns>
        <column name="id" display="none" order="100">
            <widget type="text" fieldname="idservicio"/>
        </column>
        <column name="code" order="110">
            <widget type="text" fieldname="codigo"/>
        </column>
        <column name="type" order="120">
            <widget type="select" fieldname="idtipo">
                <values source="serviciosat_tipos" fieldcode="id" fieldtitle="name"/>
            </widget>
        </column>
        <column name="status" order="130">
            <widget type="select" fieldname="idestado">
                <values source="serviciosat_estados" fieldcode="id" fieldtitle="nombre"/>
            </widget>
        </column>
        <column name="description" order="140">
            <widget type="textarea" fieldname="descripcion"/>
        </column>
        <column name="amount" display="right" order="150">
            <widget type="money" fieldname="neto"/>
        </column>
        <column name="date" display="right" order="160">
            <widget type="date" fieldname="fecha"/>
        </column>
    </columns>
    <rows>
        <row type="status">
        </row>
    </rows>
</view>
