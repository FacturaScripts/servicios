<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : EditContacto.xml
    Description:
        Añade el permiso para ver los servicios en el portal cliente, junto al resto de
        permisos del portal si el plugin PortalCliente está activo.
-->
<view>
    <columns>
        <group name="portal-cliente-advanced" numcolumns="12" valign="bottom">
            <column name="allow-show-services" order="185">
                <widget type="checkbox" fieldname="pc_allow_show_service"/>
            </column>
        </group>
    </columns>
</view>
